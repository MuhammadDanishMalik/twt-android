<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice notes on the feed. Asked for at the moment Tanha taps record,
         never at launch: a trading app requesting the microphone on first run
         looks like something else entirely. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Optional, so a device without a camera can still install and use the
         gallery half of the avatar picker. No CAMERA permission is declared:
         ACTION_IMAGE_CAPTURE hands the work to the camera app, and declaring
         the permission would only oblige the app to ask for one it never uses. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!--
      Android 13+. Requested at the moment a member follows their first trade,
      not at launch: that is the first point at which they have an obvious reason
      to say yes, having just asked to be told what happens to it.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: lets a followed trade's progress card show as a Live Update
         (status-bar chip, lock screen). Granted at install; no prompt. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
      Opening WhatsApp, the access page and YouTube. Package visibility on
      Android 11+ means an ACTION_VIEW intent this app cannot "see" silently
      resolves to nothing, so the browser and the WhatsApp deep link are
      declared here.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".TwtApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Twt"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Twt"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Home-screen widgets, drawn with Glance.

          Both read the snapshot the app leaves in DataStore (see WidgetStore) —
          a widget cannot open a Firestore listener, so the app hands it a
          finished picture and asks for a redraw when it changes. updatePeriod
          in the XML is only the fallback for a phone whose app has not run.
        -->
        <receiver
            android:name=".core.widget.SignalsWidgetReceiver"
            android:exported="false"
            android:label="TWT Signals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/signals_widget_info" />
        </receiver>

        <receiver
            android:name=".core.widget.AccessCardWidgetReceiver"
            android:exported="false"
            android:label="TWT Access Card">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/access_widget_info" />
        </receiver>

        <service
            android:name=".core.notifications.TwtMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          The status-bar icon and accent FCM falls back to for a notification the
          app did not build itself. Without these a data-only payload handled
          while the app is dead renders with the launcher icon squashed into a
          grey square.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_signal" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/twt_gold" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <!-- Hands the camera app a URI it may write to, without exposing the
             app's storage. Authority is derived from the package so debug and
             release builds installed side by side do not collide. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
