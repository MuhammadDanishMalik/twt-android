<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows before the widget is placed. A static preview,
  not a render: the real one needs the member's data, and the picker runs before
  anybody has chosen anything.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TWT"
        android:textColor="#9A9A9A"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="XAU/USD"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="BUY · TP1 HIT"
        android:textColor="#33C759"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="+56 pips"
        android:textColor="#33C759"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
