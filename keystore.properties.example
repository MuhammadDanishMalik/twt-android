# Copy to keystore.properties and fill in. That file is gitignored.
#
# Generate the keystore once, and keep it safe — losing it means you can never
# update this app on Play again, only publish a new listing:
#
#   keytool -genkey -v -keystore twt-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias twt
#
storeFile=../twt-release.jks
storePassword=
keyAlias=twt
keyPassword=
